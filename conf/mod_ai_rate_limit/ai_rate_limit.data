{
    "Config": {
        "example_ai_product": [
            {
                "cond": "default_t()",
                "hit_action": {
                    "cmd": "FINISH",
					"params": []
                }
            }
        ]
    },
    "RateLimitPolicies": {
        "rlp-0001": {
            "name": "ratelimitX",
            "enabled": true,
            "rules": {
                "tpm": [
                    {"name":"tpmabc1", "models": ["gpt-4"], "window_minutes": 1, "max_tokens": 10000, "step_minutes": 1, "redis_key": "RL_TPM_rlp-0001_0"},
                    {"name":"tpmabc10", "models": ["*"], "window_minutes": 10, "max_tokens": 50000, "step_minutes": 1, "redis_key": "RL_TPM_rlp-0001_1"},
                    {"name":"tpmabc60", "window_minutes": 60, "max_tokens": 200000, "step_minutes": 5, "redis_key": "RL_TPM_rlp-0001_2"}
                ],
                "rpm": [
                    {"name":"rpmabc1", "window_minutes": 1, "max_requests": 100, "burst":1, "redis_key": "RL_RPM_rlp-0001_0"}
                ],
                "max_concurrency": 50,
                "batch": {
                    "max_create_rpm": 10,
                    "max_active_batches": 5,
                    "max_file_bytes": 104857600,
                    "max_file_lines": 50000,
                    "redis_key": "RL_BATCH_rlp-0001_rpm"
                }
            }
        },
        "rlp-0002": {
            "name": "ratelimitBasic",
            "enabled": true,
            "rules": {
                "tpm": [
                    {"name":"tpm1", "window_minutes": 1, "max_tokens": 200, "step_minutes": 1, "redis_key": "RL_TPM_rlp-0002_0"},
                    {"name":"tpm2", "window_minutes": 10, "max_tokens": 10000, "step_minutes": 1, "redis_key": "RL_TPM_rlp-0002_1"}
                ],
                "rpm": [
                    {"name":"rpm1", "window_minutes": 1, "max_requests": 30, "burst":1, "redis_key": "RL_RPM_rlp-0002_0"}
                ],
                "max_concurrency": 2
            }
        }
    },
    "ApikeyRateLimitPolicyBindings": {
        "YOURAPIKEY": ["rlp-0001", "rlp-0002"],
        "ak-3w9y0k4n8q": ["rlp-0002"]
    },
    "Version": "1.0"
}

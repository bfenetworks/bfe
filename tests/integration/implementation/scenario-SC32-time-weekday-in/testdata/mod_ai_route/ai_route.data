{
    "Version": "20261014150000",
    "route_rules": {
        "apikey_ak_user_a": {
            "type": "apikey",
            "owner": "ak_user_a",
            "rules": [
                {
                    "name": "weekday-work",
                    "Cond": "req_host_in(\"weekday.example.org\") && time_weekday_in(\"1|2|3|4|5\", \"H\")",
                    "targets": [
                        {
                            "ClusterName": "cluster_weekday_work",
                            "Model": "",
                            "Weight": 100
                        }
                    ],
                    "fallbacks": []
                },
                {
                    "name": "weekday-sat",
                    "Cond": "req_host_in(\"weekday.example.org\") && time_weekday_in(\"6\", \"H\")",
                    "targets": [
                        {
                            "ClusterName": "cluster_weekday_sat",
                            "Model": "",
                            "Weight": 100
                        }
                    ],
                    "fallbacks": []
                },
                {
                    "name": "weekday-sun",
                    "Cond": "req_host_in(\"weekday.example.org\") && time_weekday_in(\"0\", \"H\")",
                    "targets": [
                        {
                            "ClusterName": "cluster_weekday_sun",
                            "Model": "",
                            "Weight": 100
                        }
                    ],
                    "fallbacks": []
                },
                {
                    "name": "weekday-utc-work",
                    "Cond": "req_host_in(\"weekday-utc.example.org\") && time_weekday_in(\"1|2|3|4|5\")",
                    "targets": [
                        {
                            "ClusterName": "cluster_weekday_utc_work",
                            "Model": "",
                            "Weight": 100
                        }
                    ],
                    "fallbacks": []
                },
                {
                    "name": "weekday-utc-default",
                    "Cond": "req_host_in(\"weekday-utc.example.org\")",
                    "targets": [
                        {
                            "ClusterName": "cluster_weekday_utc_default",
                            "Model": "",
                            "Weight": 100
                        }
                    ],
                    "fallbacks": []
                }
            ]
        }
    },
    "ApikeyRouteTableBindings": {
        "ak_user_a": [
            "apikey_ak_user_a"
        ]
    }
}
{
    "Version": "20261030150000",
    "route_rules": {
        "apikey_ak_user_a": {
            "type": "apikey",
            "owner": "ak_user_a",
            "rules": [
                {
                    "name": "fallback-arm",
                    "Cond": "req_host_in(\"price-fallback.example.org\")",
                    "targets": [{"ClusterName": "cluster_price_fallback", "Model": "", "Weight": 100}],
                    "fallbacks": []
                },
                {
                    "name": "billzero-arm",
                    "Cond": "req_host_in(\"price-billzero.example.org\")",
                    "targets": [{"ClusterName": "cluster_price_billzero", "Model": "", "Weight": 100}],
                    "fallbacks": []
                },
                {
                    "name": "reject-arm",
                    "Cond": "req_host_in(\"price-reject.example.org\")",
                    "targets": [{"ClusterName": "cluster_price_reject", "Model": "", "Weight": 100}],
                    "fallbacks": []
                },
                {
                    "name": "subitem-arm",
                    "Cond": "req_host_in(\"price-subitem.example.org\")",
                    "targets": [{"ClusterName": "cluster_price_subitem", "Model": "", "Weight": 100}],
                    "fallbacks": []
                }
            ]
        }
    },
    "ApikeyRouteTableBindings": {
        "ak_user_a": ["apikey_ak_user_a"]
    }
}
